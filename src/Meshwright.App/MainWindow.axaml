<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Meshwright.App.Views"
        xmlns:edit="using:Meshwright.App.Views.Edit"
        x:Class="Meshwright.App.MainWindow"
        Title="Meshwright"
        Width="1400"
        Height="768">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource SystemAltHighColor}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="OpenFileButton" Content="Open STL..." Click="OnOpenFileClick" />
        <TextBlock Name="StatusText" VerticalAlignment="Center" Text="Loaded sample tetrahedron" />
      </StackPanel>
    </Border>

    <!-- Left sidebar: Edit operations panel with tabs -->
    <Border DockPanel.Dock="Left" Width="320" Padding="0" Background="{DynamicResource SystemAltHighColor}">
      <TabControl Name="EditTabControl">
        <TabItem Header="Plane Cut">
          <edit:PlaneCutPanel Name="PlaneCutPanel" />
        </TabItem>
        <TabItem Header="Transform">
          <edit:TransformPanel Name="TransformPanel" />
        </TabItem>
        <TabItem Header="Hollow">
          <edit:HollowPanel Name="HollowPanel" />
        </TabItem>
        <TabItem Header="Drain Holes">
          <edit:DrainHolePanel Name="DrainHolePanel" />
        </TabItem>
        <TabItem Header="Decimate">
          <edit:DecimatePanel Name="DecimatePanel" />
        </TabItem>
        <TabItem Header="Boolean">
          <edit:BooleanPanel Name="BooleanPanel" />
        </TabItem>
      </TabControl>
    </Border>

    <!-- Right sidebar: Diagnostics panel -->
    <Border DockPanel.Dock="Right" Width="300" Padding="8" Background="{DynamicResource SystemAltHighColor}">
      <ScrollViewer>
        <StackPanel Spacing="8">
          <TextBlock Text="Diagnostics" FontWeight="Bold" />
          <TextBlock Name="StatisticsText" TextWrapping="Wrap" />
          <TextBlock Name="SummaryText" TextWrapping="Wrap" FontStyle="Italic" />
          <ItemsControl Name="IssuesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:CompileBindings="False">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Center: Viewport -->
    <Panel>
      <views:MeshViewportControl Name="Viewport" />
      <!-- Transparent hit-test overlay: on Linux the GL surface doesn't reliably participate in
           Avalonia's input routing, so pointer events are forwarded through this overlay instead. -->
      <Border Name="ViewportInputOverlay"
              Background="Transparent"
              PointerPressed="OnViewportPointerPressed"
              PointerMoved="OnViewportPointerMoved"
              PointerReleased="OnViewportPointerReleased"
              PointerWheelChanged="OnViewportPointerWheelChanged" />
    </Panel>
  </DockPanel>
</Window>

