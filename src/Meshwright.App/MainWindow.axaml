<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Meshwright.App.Views"
        xmlns:edit="using:Meshwright.App.Views.Edit"
        x:Class="Meshwright.App.MainWindow"
        Title="Meshwright"
        Width="1400"
        Height="768"
        KeyDown="OnMainWindowKeyDown">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Name="OpenMenuItem" Header="_Open..." Click="OnOpenFileClick" />
        <!-- Filled in code from AppSettings.RecentFiles; see RefreshRecentFilesMenu. -->
        <MenuItem Name="RecentFilesMenuItem" Header="Open _Recent" />
        <MenuItem Name="ExportMenuItem" Header="_Export..." Click="OnExportFileClick" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Name="UndoMenuItem" Header="_Undo" Click="OnUndoClick" HotKey="Ctrl+Z" />
        <MenuItem Name="RedoMenuItem" Header="_Redo" Click="OnRedoClick" HotKey="Ctrl+Y" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Name="ResetViewMenuItem" Header="_Reset View" Click="OnResetViewClick" HotKey="Ctrl+D0" />
        <Separator />
        <!-- Standard views. HotKey wants the digit key's enum name ("D1"), not the literal digit:
             "Ctrl+1" parses to Key.None and binds the shortcut to nothing at all (§11). -->
        <MenuItem Name="FrontViewMenuItem" Header="_Front" Click="OnStandardViewClick" Tag="Front" HotKey="Ctrl+D1" />
        <MenuItem Name="BackViewMenuItem" Header="_Back" Click="OnStandardViewClick" Tag="Back" HotKey="Ctrl+D2" />
        <MenuItem Name="LeftViewMenuItem" Header="_Left" Click="OnStandardViewClick" Tag="Left" HotKey="Ctrl+D3" />
        <MenuItem Name="RightViewMenuItem" Header="Ri_ght" Click="OnStandardViewClick" Tag="Right" HotKey="Ctrl+D4" />
        <MenuItem Name="TopViewMenuItem" Header="_Top" Click="OnStandardViewClick" Tag="Top" HotKey="Ctrl+D5" />
        <MenuItem Name="BottomViewMenuItem" Header="B_ottom" Click="OnStandardViewClick" Tag="Bottom" HotKey="Ctrl+D6" />
        <MenuItem Name="IsometricViewMenuItem" Header="_Isometric" Click="OnStandardViewClick" Tag="Isometric" HotKey="Ctrl+D7" />
        <Separator />
        <MenuItem Name="PerspectiveMenuItem" Header="_Perspective" Click="OnProjectionModeClick" Tag="Perspective"
                  ToggleType="Radio" GroupName="Projection" IsChecked="True" HotKey="Ctrl+Shift+P" />
        <MenuItem Name="OrthographicMenuItem" Header="_Orthographic" Click="OnProjectionModeClick" Tag="Orthographic"
                  ToggleType="Radio" GroupName="Projection" HotKey="Ctrl+Shift+O" />
        <Separator />
        <MenuItem Name="ShadedDisplayMenuItem" Header="_Shaded" Click="OnDisplayModeClick" Tag="Shaded"
                  ToggleType="Radio" GroupName="DisplayMode" IsChecked="True" HotKey="Ctrl+Shift+S" />
        <MenuItem Name="WireframeDisplayMenuItem" Header="_Wireframe" Click="OnDisplayModeClick" Tag="Wireframe"
                  ToggleType="Radio" GroupName="DisplayMode" HotKey="Ctrl+Shift+W" />
        <MenuItem Name="XRayDisplayMenuItem" Header="_X-Ray" Click="OnDisplayModeClick" Tag="XRay"
                  ToggleType="Radio" GroupName="DisplayMode" HotKey="Ctrl+Shift+X" />
        <Separator />
        <!-- The bed size choices are generated in code from BuildVolume.Presets, so the menu and
             the list of printers cannot drift apart. -->
        <MenuItem Name="BuildPlateMenuItem" Header="_Build Plate">
          <MenuItem Name="ShowBuildPlateMenuItem" Header="_Show Build Plate" Click="OnToggleBuildPlateClick"
                    ToggleType="CheckBox" IsChecked="True" HotKey="Ctrl+Shift+B" />
          <Separator />
        </MenuItem>
        <Separator />
        <!-- The axis and the position live on the bar under the viewport rather than being
             mirrored here: one control per piece of state, so there is no second copy to drift
             out of step with the plane actually being drawn (§11, 2026-09-06). -->
        <MenuItem Name="ShowCrossSectionMenuItem" Header="Cross-_Section" Click="OnToggleCrossSectionClick"
                  ToggleType="CheckBox" HotKey="Ctrl+Shift+C" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource SystemAltHighColor}">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="OpenFileButton" Content="Open STL..." Click="OnOpenFileClick" />
          <Button Name="ExportFileButton" Content="Export..." Click="OnExportFileClick" />
          <Button Name="ResetViewButton" Content="Reset View" Click="OnResetViewClick"
                  ToolTip.Tip="Refit the camera on the mesh (Ctrl+0)" />
          <TextBlock Name="StatusText" VerticalAlignment="Center" Text="Loaded sample tetrahedron" />
          <TextBlock Name="UndoRedoStatusText" VerticalAlignment="Center" Foreground="Gray" />
          <!-- Out-of-bounds warning. Hidden while the model fits: a warning that is always on
               says as little as one that never fires. -->
          <TextBlock Name="BuildPlateWarningText" VerticalAlignment="Center" Foreground="#FFB020"
                     FontWeight="SemiBold" IsVisible="False" TextWrapping="NoWrap" />
        </StackPanel>
        <!-- Busy indicator for the in-flight operation (§6.3, backlog item 13). Hidden while
             MeshDocument.IsBusy is false. The progress bar is indeterminate unless
             MeshDocument.Progress actually reports a real fraction (AutoRepairPipeline only) —
             faking a determinate bar for an opaque one-shot operation would be a lie (§4). -->
        <StackPanel Name="OperationProgressPanel" Orientation="Horizontal" Spacing="8" IsVisible="False">
          <ProgressBar Name="OperationProgressBar" Width="160" Height="14" IsIndeterminate="True" Minimum="0" Maximum="1" />
          <TextBlock Name="OperationProgressText" VerticalAlignment="Center" Text="Working..." />
          <Button Name="CancelOperationButton" Content="Cancel" Click="OnCancelOperationClick" IsEnabled="False" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Left sidebar: Edit operations panel with tabs -->
    <Border DockPanel.Dock="Left" Width="320" Padding="0" Background="{DynamicResource SystemAltHighColor}">
      <TabControl Name="EditTabControl">
        <TabItem Header="Repair">
          <edit:RepairPanel Name="RepairPanel" />
        </TabItem>
        <TabItem Header="Plane Cut">
          <edit:PlaneCutPanel Name="PlaneCutPanel" />
        </TabItem>
        <TabItem Header="Transform">
          <edit:TransformPanel Name="TransformPanel" />
        </TabItem>
        <TabItem Header="Hollow">
          <edit:HollowPanel Name="HollowPanel" />
        </TabItem>
        <TabItem Header="Drain Holes">
          <edit:DrainHolePanel Name="DrainHolePanel" />
        </TabItem>
        <TabItem Header="Decimate">
          <edit:DecimatePanel Name="DecimatePanel" />
        </TabItem>
        <TabItem Header="Boolean">
          <edit:BooleanPanel Name="BooleanPanel" />
        </TabItem>
      </TabControl>
    </Border>

    <!-- Right sidebar: Diagnostics panel -->
    <Border DockPanel.Dock="Right" Width="300" Padding="8" Background="{DynamicResource SystemAltHighColor}">
      <ScrollViewer>
        <StackPanel Spacing="8">
          <TextBlock Text="Diagnostics" FontWeight="Bold" />
          <TextBlock Name="StatisticsText" TextWrapping="Wrap" />
          <TextBlock Name="SummaryText" TextWrapping="Wrap" FontStyle="Italic" />
          <ItemsControl Name="IssuesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:CompileBindings="False">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Center: Viewport, with the unit offer above it and the cross-section slider under it -->
    <DockPanel>
      <!-- The mm/inch offer. An STL carries no units, so this is a guess about intent, and it is
           only ever offered: nothing is scaled until the button here is pressed, and doing nothing
           is the default. Silently multiplying a model by 25.4 would look identical on screen and
           be discovered at the printer (§11). -->
      <Border Name="UnitSuggestionBar" DockPanel.Dock="Top" IsVisible="False"
              Padding="10,7" Background="#3A3320" BorderBrush="#FFB020" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Name="UnitSuggestionText" Grid.Column="0" VerticalAlignment="Center"
                     TextWrapping="Wrap" Foreground="#FFD98A" Margin="0,0,10,0" />
          <Button Name="UnitSuggestionAcceptButton" Grid.Column="1" Margin="0,0,6,0"
                  Click="OnAcceptUnitSuggestionClick"
                  ToolTip.Tip="Scale the model as if the file was written in inches. Undoable." />
          <Button Name="UnitSuggestionDismissButton" Grid.Column="2" Content="Keep as-is"
                  Click="OnDismissUnitSuggestionClick"
                  ToolTip.Tip="Leave the model exactly as the file describes it" />
        </Grid>
      </Border>
      <!-- Hidden until View -> Cross-Section is on. A slider is docked below the viewport rather
           than added as an eighth sidebar tab because it is a way of looking at the model, not an
           operation on it: nothing here changes a triangle or pushes an undo entry. -->
      <Border Name="CrossSectionBar" DockPanel.Dock="Bottom" IsVisible="False"
              Padding="8,6" Background="{DynamicResource SystemAltHighColor}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Cross-section" VerticalAlignment="Center" FontWeight="SemiBold" />
          <!-- Both are subscribed in code-behind, on the Avalonia properties rather than on the
               SelectionChanged/ValueChanged routed events: a routed event never fires for a
               control exercised outside a visual tree, which is how the drain-hole gizmo shipped
               placing every hole at a hard-coded 2 mm behind a green suite (§11, 2026-09-06). -->
          <ComboBox Name="CrossSectionAxisCombo" Width="110" VerticalAlignment="Center"
                    ToolTip.Tip="Which axis the section plane slides along" />
          <Slider Name="CrossSectionSlider" Width="360" VerticalAlignment="Center"
                  ToolTip.Tip="Where the section plane sits, in millimetres" />
          <TextBlock Name="CrossSectionPositionText" VerticalAlignment="Center" MinWidth="88" />
          <Button Name="CrossSectionFlipButton" Content="Flip Side" Click="OnFlipCrossSectionClick"
                  ToolTip.Tip="Show the other half instead" />
        </StackPanel>
      </Border>
      <Panel>
        <views:MeshViewportControl Name="Viewport" />
        <!-- Transparent hit-test overlay: on Linux the GL surface doesn't reliably participate in
             Avalonia's input routing, so pointer events are forwarded through this overlay instead. -->
        <Border Name="ViewportInputOverlay"
                Background="Transparent"
                PointerPressed="OnViewportPointerPressed"
                PointerMoved="OnViewportPointerMoved"
                PointerReleased="OnViewportPointerReleased"
                PointerWheelChanged="OnViewportPointerWheelChanged" />
        <!-- Shown while a mesh file is being dragged over the window. Not hit-test visible: it
             must not become the thing the drag is over. The drag handlers are on the Window, not
             on this or on the viewport control - the GL surface does not reliably participate in
             Avalonia's input routing on Linux, which is why ViewportInputOverlay above exists at
             all, and a drop target attached to it would be attached to the one control that never
             sees the event. -->
        <Border Name="DropHintOverlay" IsVisible="False" IsHitTestVisible="False"
                Background="#99102030" BorderBrush="#4FC3F7" BorderThickness="3">
          <TextBlock Name="DropHintText" HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="26" FontWeight="Bold" Foreground="#DCF2FF" TextAlignment="Center" />
        </Border>
      </Panel>
    </DockPanel>
  </DockPanel>
</Window>

