<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Meshwright.App.Views.Edit.BooleanPanel"
             Width="300">
  <ScrollViewer>
    <Border Padding="8">
      <StackPanel Spacing="12">
        <TextBlock Text="Boolean Operations" FontWeight="Bold" />

        <StackPanel Spacing="4">
          <TextBlock Text="Operation:" />
          <ComboBox Name="OperationSelector">
            <ComboBoxItem>Union</ComboBoxItem>
            <ComboBoxItem>Difference (Primary - Secondary)</ComboBoxItem>
            <ComboBoxItem>Intersection</ComboBoxItem>
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Secondary mesh:" />
          <TextBlock Name="SecondaryMeshStatusText" TextWrapping="Wrap" FontSize="11" Foreground="Gray" />
          <Button Name="LoadSecondaryButton" Content="Load Secondary Mesh..." Click="OnLoadSecondaryClick" />
        </StackPanel>

        <Button Name="ApplyButton" Content="Apply" Click="OnApplyClick" />

        <StackPanel Spacing="4">
          <TextBlock Text="Before:" TextWrapping="Wrap" />
          <TextBlock Name="BeforeStats" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="After:" TextWrapping="Wrap" />
          <TextBlock Name="AfterStats" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Name="ResultMessageText" TextWrapping="Wrap" FontStyle="Italic" />
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
