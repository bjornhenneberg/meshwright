<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Meshwright.App.Views.Edit.DecimatePanel"
             Padding="8">
  <StackPanel Spacing="8">
    <TextBlock Text="Simplify (Decimation)" FontWeight="Bold" FontSize="14" />

    <!-- Mode selector: TriangleCount or Percentage -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Mode:" VerticalAlignment="Center" />
      <ComboBox Name="ModeCombo" VerticalAlignment="Center" Width="120">
        <ComboBoxItem>Triangle Count</ComboBoxItem>
        <ComboBoxItem>Percentage</ComboBoxItem>
      </ComboBox>
    </StackPanel>

    <!-- Target input: numeric field with label -->
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Target:" VerticalAlignment="Center" />
      <TextBox Name="TargetInput"
               Text="100"
               VerticalAlignment="Center"
               Width="80" />
      <TextBlock Name="TargetUnitLabel" Text="triangles" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Live before/after readout: shows current count and resolved target without running decimation -->
    <Border Padding="8" Background="{DynamicResource SystemAltLowColor}" CornerRadius="4">
      <TextBlock Name="LivePreviewText"
                 TextWrapping="Wrap"
                 Text="Current: — triangles, Target: — triangles" />
    </Border>

    <!-- Apply button -->
    <Button Name="ApplyButton"
            Content="Apply Decimation"
            Click="OnApplyClick"
            HorizontalAlignment="Left"
            Padding="12,6" />

    <!-- Status/result message -->
    <TextBlock Name="ResultText"
               TextWrapping="Wrap"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
               FontSize="11"
               IsVisible="False" />
  </StackPanel>
</UserControl>
