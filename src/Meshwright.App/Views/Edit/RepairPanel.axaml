<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Meshwright.App.Views.Edit.RepairPanel"
             Width="300">
  <ScrollViewer>
    <Border Padding="8">
      <StackPanel Spacing="12">
        <TextBlock Text="Repair" FontWeight="Bold" />

        <StackPanel Spacing="4">
          <TextBlock Text="Runs the five repair steps in the order that works on most meshes. Undoes as a single step."
                     TextWrapping="Wrap"
                     FontSize="11"
                     Opacity="0.8" />
          <Button Name="AutoRepairButton"
                  Content="Auto Repair"
                  Click="OnAutoRepairClick"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="12,8" />
        </StackPanel>

        <Separator />

        <TextBlock Text="Individual steps" FontWeight="Bold" FontSize="12" />

        <Button Name="RemoveDegenerateButton"
                Content="Remove Degenerate &amp; Duplicates"
                Click="OnRemoveDegenerateClick"
                HorizontalAlignment="Stretch" />

        <StackPanel Spacing="4">
          <TextBlock Text="Smallest shell to keep (fraction of mesh volume):" TextWrapping="Wrap" FontSize="11" />
          <TextBox Name="MinVolumeFractionInput" Text="0.01" />
          <Button Name="RemoveSmallShellsButton"
                  Content="Remove Small Shells"
                  Click="OnRemoveSmallShellsClick"
                  HorizontalAlignment="Stretch" />
        </StackPanel>

        <Button Name="ResolveSelfIntersectionsButton"
                Content="Resolve Self-Intersections"
                Click="OnResolveSelfIntersectionsClick"
                HorizontalAlignment="Stretch" />

        <StackPanel Spacing="4">
          <TextBlock Text="Hole fill style:" FontSize="11" />
          <ComboBox Name="HoleFillModeCombo" SelectedIndex="1" HorizontalAlignment="Stretch">
            <ComboBoxItem>Flat (fan from centre)</ComboBoxItem>
            <ComboBoxItem>Planar (best-fit plane)</ComboBoxItem>
            <ComboBoxItem>Smooth (planar, less faceted)</ComboBoxItem>
          </ComboBox>
          <Button Name="FillHolesButton"
                  Content="Fill Holes"
                  Click="OnFillHolesClick"
                  HorizontalAlignment="Stretch" />
        </StackPanel>

        <Button Name="UnifyNormalsButton"
                Content="Unify Normals"
                Click="OnUnifyNormalsClick"
                HorizontalAlignment="Stretch" />

        <Separator />

        <StackPanel Spacing="4">
          <TextBlock Text="Last resort — rebuilds the mesh from a voxel grid. Makes almost anything printable, but discards fine detail."
                     TextWrapping="Wrap"
                     FontSize="11"
                     Opacity="0.8" />
          <TextBlock Text="Resolution along longest axis:" FontSize="11" />
          <TextBox Name="VoxelResolutionInput" Text="128" />
          <Button Name="VoxelRemeshButton"
                  Content="Voxel Remesh"
                  Click="OnVoxelRemeshClick"
                  HorizontalAlignment="Stretch" />
        </StackPanel>

        <Separator />

        <StackPanel Spacing="4">
          <TextBlock Text="Before:" TextWrapping="Wrap" />
          <TextBlock Name="BeforeStats" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="After:" TextWrapping="Wrap" />
          <TextBlock Name="AfterStats" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Name="ResultMessageText" TextWrapping="Wrap" FontStyle="Italic" />
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
