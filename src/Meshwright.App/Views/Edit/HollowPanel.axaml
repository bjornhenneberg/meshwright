<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Meshwright.App.Views.Edit.HollowPanel"
             Width="300">
  <ScrollViewer>
    <Border Padding="8">
      <StackPanel Spacing="12">
      <TextBlock Text="Hollow" FontWeight="Bold" />

      <StackPanel Spacing="4">
        <TextBlock Text="Wall Thickness (mm):" />
        <TextBox Name="WallThicknessInput" Text="2.0" />
      </StackPanel>

      <Button Name="ApplyButton" Content="Apply" Click="OnApplyClick" />

      <StackPanel Spacing="4">
        <TextBlock Text="Before:" TextWrapping="Wrap" />
        <TextBlock Name="BeforeStats" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="After:" TextWrapping="Wrap" />
        <TextBlock Name="AfterStats" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Name="ResultMessageText" TextWrapping="Wrap" FontStyle="Italic" />
      </StackPanel>
    </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
